# Copy to local ignored .env; never commit real credentials.
# No paid cards, automatic upgrades, or provider calls before rights/entitlement approval.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_SALT=
GEOAPIFY_API_KEY=
GEOAPIFY_RIGHTS_CONFIRMED=false
CONTENT_BBOX=98.2,7.7,98.5,8.2
CATALOG_RIGHTS_CONFIRMED=false
EXPORT_MODE=preview
DATABASE_URL=
AGE_RECIPIENT=
AGE_IDENTITY_FILE=
# Verified PG17 backup client image. Production requires this immutable digest.
PG_BACKUP_IMAGE=postgis/postgis:17-3.5@sha256:01a6a70e41e6c4467c8f55f6063555ed72db2d6662cd0d571040d42eadaeb6f6
# Nonsecret account budget evidence; never assume billing/provider usage.
# Exact selected Vercel project and account; local link must match both.
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
# Optional absolute path to an already installed Vercel Node CLI entrypoint.
VERCEL_CLI_PATH=
HOSTING_PROVIDER=vercel
VERCEL_TOKEN=
# Opt-in only after account, actual rights, data, legal and hosted UAT verification.
AUTOMATION_ENABLED=false
GITHUB_DEPLOY_TOKEN=
GITHUB_DEPLOY_REF=
# Reviewed JSON is supplied as private CI secrets, not made up by scripts.
PRODUCTION_LEGAL_JSON=
PRODUCTION_LAUNCH_EVIDENCE_JSON=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PROJECT_NAME=thaimora
# Must match the existing Pages project's production branch; no inferred branch.
CLOUDFLARE_PRODUCTION_BRANCH=
CLOUDFLARE_PROJECT_NAMES=thaimora,taotide
CLOUDFLARE_API_TOKEN=
GITHUB_BUDGET_TOKEN=
GITHUB_BUDGET_REPOSITORIES=
POI_LICENSE_CONFIRMED=false

NEXT_PUBLIC_DATA_MODE=demo
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_ARCGIS_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LINE_URL=
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
THAIMORA_SNAPSHOT_PATH=scripts/output/public-content.json
THAIMORA_LEGAL_PATH=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=
RESEND_API_KEY=
INQUIRY_EMAIL_TO=
INQUIRY_EMAIL_FROM=
EMAIL_WORKER_SECRET=
